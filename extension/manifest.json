{
  "manifest_version": 3,
  "name": "MX Console Bridge for Onshape",
  "short_name": "MX Bridge",
  "version": "0.1.0",
  "description": "Lets the Logitech MX Creative Console drive Onshape: presses toolbar tools and follows sketches and feature dialogs.",
  "homepage_url": "https://github.com/xfanta/onshape-mx",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.onshape.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms"
  ],
  "host_permissions": [
    "https://*.onshape.com/*",
    "ws://127.0.0.1/*"
  ]
}
